# 관리자 웹 보고서 — 소스/Git에 실제 값을 넣지 마세요.
# 로컬: 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
# Vercel: Project → Settings → Environment Variables 에 Production/Preview 모두 등록합니다.
#   필수: ADMIN_PASSWORD (또는 ADMIN_PASSWORD_HASH), ADMIN_SESSION_SECRET
#   선택: DALBIT_ALLOW_SERVER_PDF=1  (기본 비권장 — 브라우저 인쇄·PDF 저장 사용)

# 로그인 비밀번호 (둘 중 하나)
ADMIN_PASSWORD=change-me-to-a-long-secret
# 또는 scrypt 해시 (권장): saltHex:hashHex
# ADMIN_PASSWORD_HASH=

# 세션 쿠키 서명용 (긴 난수 문자열, 32자 이상 권장)
ADMIN_SESSION_SECRET=replace-with-long-random-string
